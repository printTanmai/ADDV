// ====================================================================
// CASE 1: BASIC ISA INSTRUCTION TEST SUITE (ADDI, SUB, AND, OR, SLT, SW)
// ====================================================================
20010005 // addi $1, $0, 5     # $1 = 5
2002000a // addi $2, $0, 10    # $2 = 10
00411822 // sub  $3, $2, $1    # $3 = 10 - 5 = 5 (SUB)
00412024 // and  $4, $2, $1    # $4 = 10 & 5 = 0 (AND)
00412825 // or   $5, $2, $1    # $5 = 10 | 5 = 15 (OR)
0022302a // slt  $6, $1, $2    # $6 = (5 < 10) = 1 (SLT)
ac050050 // sw   $5, 80($0)   # STORE 1: Write $5 (val: 15 / 0x0F) to addr 0x50

// ====================================================================
// CASE 2: ADD DATA HAZARDS & FORWARDING STRESS TEST (REGISTERS RESET)
// ====================================================================
20010005 // addi $1, $0, 5     # Reset $1 = 5
2002000a // addi $2, $0, 10    # Reset $2 = 10
20030014 // addi $3, $0, 20    # Reset $3 = 20
00223820 // add  $7, $1, $2    # $7 = 15
00e34020 // add  $8, $7, $3    # $8 = 35 [EX/MEM -> Operand A]
00684820 // add  $9, $3, $8    # $9 = 55 [EX/MEM -> Operand B]
00225020 // add  $10, $1, $2   # $10 = 15
200b0001 // addi $11, $0, 1    # $11 = 1 (Separation cycle)
01436020 // add  $12, $10, $3  # $12 = 35 [MEM/WB -> Operand A]
00226820 // add  $13, $1, $2   # $13 = 15 (Distance 2)
00617020 // add  $14, $3, $1   # $14 = 25 (Distance 1)
01cd7820 // add  $15, $14, $13 # $15 = 40 (0x28) [Dual Forwarding]
20100064 // addi $16, $0, 100  # $16 = 100
201000c8 // addi $16, $0, 200  # $16 = 200
02008820 // add  $17, $16, $0  # $17 = 200 [Priority Check]
ac0f0054 // sw   $15, 84($0)   # STORE 2: Write $15 (val: 40 / 0x28) to addr 0x54

// ====================================================================
// CASE 3: CONTROL HAZARDS & BEQ FLUSHING TEST (REGISTERS RESET)
// ====================================================================
8c120050 // lw   $18, 80($0)   # Load $18 = 15 from addr 0x50
02469820 // add  $19, $18, $6  # Load-Use Stall: $19 = 15 + 1 = 16
12610005 // beq  $19, $1, 5    # [BEQ NOT TAKEN] 16 != 5 -> No flush
20140002 // addi $20, $0, 2    # $20 = 2
0261a822 // sub  $21, $19, $1  # $21 = 16 - 5 = 11
2016000b // addi $22, $0, 11   # $22 = 11
12b60002 // beq  $21, $22, 2   # [BEQ TAKEN] 11 == 11 -> TAKEN!
20140063 // addi $20, $0, 99   # [TRAP 1 - FLUSHED IN ID]
20140063 // addi $20, $0, 99   # [TRAP 2 - FLUSHED IN IF]
0293b820 // add  $23, $20, $19 # [BRANCH TARGET] $23 = 2 + 16 = 18 (0x12)
ac170058 // sw   $23, 88($0)   # STORE 3: Write $23 (val: 18 / 0x12) to addr 0x58

// ====================================================================
// CASE 4: MULADD with destination register as the third operand
// ====================================================================
20180003 // addi   $24, $0, 3
20190004 // addi   $25, $0, 4
201a0005 // addi   $26, $0, 5
0319d018 // muladd $26, $24, $25 # $26 = 3 * 4 + old $26 = 17
0319d018 // muladd $26, $24, $25 # $26 = 3 * 4 + 17 = 29 (forward old rd)
ac1a005c // sw     $26, 92($0)   # STORE 4: Write 29 to address 0x5c
8c1b005c // lw     $27, 92($0)   # Load 29 for MULADD's third operand
0319d818 // muladd $27, $24, $25 # Load-use stall; $27 = 29 + 3 * 4 = 41
ac1b0060 // sw     $27, 96($0)   # STORE 5: Write 41 to address 0x60
741c0001 // perfmon $28, 1      # Read completed-instruction count
ac1c0064 // sw      $28, 100($0) # STORE 6: Save instruction counter
741d0000 // perfmon $29, 0      # Read elapsed-cycle count
ac1d0068 // sw      $29, 104($0) # STORE 7: Save cycle counter
